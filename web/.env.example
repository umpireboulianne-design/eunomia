VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Relay network and fee-floor defaults (server-only, worker/index.ts):
# Must be `pubnet` (anything else is refused).
RELAY_NETWORK=
# Maximum fee per sponsored transaction in XLM (defaults to 1).
RELAY_MAX_FEE_XLM=
# Minimum XLM balance below which the fee account stops sponsoring (defaults to 5).
RELAY_MIN_BALANCE_XLM=

# WalletConnect / Reown project id — enables mobile wallets (Freighter mobile connects
# over WalletConnect v2). Get a free id at https://cloud.reown.com. Without it, only the
# desktop extension wallets are offered.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Network (build-time, src/networks.ts) ----------------------------------
# The app runs on Stellar mainnet only. `npm run build` and `npm run dev` refuse to
# start until all three are set. Public values: they end up in the bundle.
#
# The RPC the page talks to. A deployed build uses its own https://<host>/api/rpc, which
# forwards to the provider in RELAY_RPC_URL; never a provider URL with a key in it, and
# never a public default (its simulation decides what a passkey is asked to sign over).
# For `npm run dev` on this machine only, the provider URL itself works. https only.
EUNOMIA_RPC_URL=
# The treasury factory and registry we deployed (C… contract ids). The deposit caps live
# in the factory, one per token.
EUNOMIA_FACTORY_ID=
EUNOMIA_REGISTRY_ID=

# --- Relay (server-only, worker/index.ts) -----------------------------------
# NEVER prefix any of these with VITE_: Vite inlines VITE_* into the bundle as
# literals, so a VITE_-prefixed key ends up readable in the published main.js.
# On Cloudflare the non-secret ones are `vars` in wrangler.jsonc and RELAY_SECRET is
# a `wrangler secret`.
#
# Secret (S…) of the fee account that pays for passkey users' transactions.
RELAY_SECRET=
# The RPC provider's URL (it carries the account key): the relay simulates and submits
# through it, and /api/rpc forwards the page's calls to it. A secret on Cloudflare. Required.
RELAY_RPC_URL=
# The treasury factory the relay admits by address. Required for setup to work.
RELAY_FACTORY_ID=
# The most the relay spends on fees in one UTC day, in XLM. Required.
RELAY_DAILY_BUDGET_XLM=
# Comma-separated. Fixed contracts the relay may call by address (the registry).
RELAY_ALLOWED_CONTRACTS=
# Comma-separated wasm hashes. Covers the per-user treasuries and passkey wallets, whose
# addresses cannot be known up front — a contract is admitted when its code is ours.
RELAY_ALLOWED_WASM=
